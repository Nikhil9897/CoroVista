# CoroVista Backend Environment Configuration Template

# Runtime environment (development, test, production)
COROVISTA_ENV=development

# API route prefix
COROVISTA_API_PREFIX=/api/v1

# Permitted CORS origins (comma-separated list for local frontend or production domain)
COROVISTA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Directory containing serialized model artifacts
COROVISTA_MODEL_DIR=models
